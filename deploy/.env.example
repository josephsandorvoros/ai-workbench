# AI Workbench appliance — copy to .env and edit.
# Only LLM_BASE_URL is required. Secrets are auto-generated on first boot.

# --- Images -----------------------------------------------------------------
WORKBENCH_IMAGE_PREFIX=ghcr.io/josephsandorvoros
WORKBENCH_TAG=latest

# --- Model endpoint (OpenAI-compatible: llama.cpp, vLLM, Ollama, LM Studio, ...) ---
# Include the /v1 suffix. A model server on the VM host itself: http://host.docker.internal:8080/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Used for the context meter when the llama.cpp /props probe is unavailable.
MODEL_CONTEXT_FALLBACK=32768

# --- Resource monitor (header CPU / RAM / GPU / disk / temps) ---------------
# Empty = the machine running this stack (no GPU stats inside the container).
# To watch another machine (e.g. your GPU box), run Glances there in web mode:
#   pip install 'glances[web]' && glances -w --disable-webui     (listens on :61208)
# or: docker run -d --restart unless-stopped --pid host --network host \
#       -e GLANCES_OPT="-w --disable-webui" nicolargo/glances:latest-full
# For NVIDIA GPUs the Glances container needs GPU access (see deploy/README.md).
# Then point this at it (61208 by default, or whatever host port you published).
GLANCES_URL=
# Filesystem to report as "Disk" on the Glances host
GLANCES_DISK_MOUNT=/
# GPU to show when there are several (e.g. nvidia0); defaults to the first NVIDIA GPU
GLANCES_GPU_ID=

# --- Optional voice-service URL defaults (overrides are managed in the UI) --
# The companion calls these fixed wrapper bases; browsers only call /api/speech/*.
# Tokens are write-only secrets in /opt/data/spatial-workbench/settings.json,
# under secrets.speech:stt and secrets.speech:tts. Never put token values here.
SPEECH_STT_URL=
SPEECH_TTS_URL=

# --- Main OpenCode (independent; defaults to hosted big-pickle) ---------------
# provider/model. Free hosted examples (no key): opencode/big-pickle, opencode/deepseek-v4-flash-free
# With a provider key below: anthropic/claude-sonnet-4-5, openai/gpt-5, openrouter/<model>
OPENCODE_MODEL=opencode/big-pickle
# Separate OpenAI-compatible endpoint for OpenCode (provider "custom"; set OPENCODE_MODEL to the model name)
OPENCODE_CUSTOM_BASE_URL=
OPENCODE_CUSTOM_API_KEY=
# Optional key for the selected built-in provider (alternative to provider-specific keys below).
OPENCODE_MAIN_API_KEY=
# Provider keys OpenCode reads directly
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- UI exposure and auth ---------------------------------------------------
# The UI has no login of its own and can drive an agent with shell access.
# proxy (default): trust your reverse proxy's login (Pangolin, Authelia, ...). Make sure the
#   port is ONLY reachable through that proxy (firewall it, or bind to the proxy's interface).
# token: additionally require TERMINAL_API_TOKEN for the CLI tab / shell tools.
WORKBENCH_AUTH=proxy
# Optional allowlist of client IPs/CIDRs, comma-separated (e.g. your reverse proxy and admin desktop).
# Matches the direct connection, so list the proxy's IP rather than users behind it. Empty = anyone.
WORKBENCH_ALLOWED_CLIENTS=
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=1420
# Optional basic auth. Hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Wrap the hash in SINGLE quotes (it contains $).
WORKBENCH_AUTH_USER=
WORKBENCH_AUTH_PASSWORD_HASH=''

# --- Secrets (leave empty to auto-generate; persisted in the hermes-data volume) ---
API_SERVER_KEY=
TERMINAL_API_TOKEN=
# Only needed if browsers call the gateway directly (the /hermes-gw proxy doesn't need it).
API_SERVER_CORS_ORIGINS=

# --- Container user mapping --------------------------------------------------
HERMES_UID=10000
HERMES_GID=10000

# --- Optional sandbox for Hermes' own terminal commands ----------------------
# 1 = Hermes shell commands execute in isolated containers; 0 = run in agent container.
# With JOBS_SANDBOX=1, also activate the Compose profile: --profile sandbox
# (or COMPOSE_PROFILES=sandbox in Portainer).
# AGENT_SANDBOX=1
# Worker image (default: Python + Node), limits, LAN exceptions, image cleanup age
SANDBOX_IMAGE=
SANDBOX_CPU=
SANDBOX_MEMORY_MB=
SANDBOX_ALLOW_LAN=
SANDBOX_PRUNE_HOURS=24

# --- Jobs worker sandbox (independent of Hermes terminal mode) ----------------
# 1 = enable optional Docker-in-Docker workers; also activate --profile sandbox.
JOBS_SANDBOX=0
# Worker containers default to no LAN access.

# --- Jobs board ---------------------------------------------------------------
# Herdr is the default worker runtime. Docker workers require JOBS_SANDBOX=1.
JOB_WORKER_RUNTIME=herdr
# Set to 1 with JOBS_SANDBOX=1 to offer Docker alongside Herdr.
JOB_HERDR_ENABLED=0
JOB_HERDR_SESSION=workbench-jobs
# Hermes reviews and plans each job; isolated OpenCode workers run subtasks;
# Hermes collates the results. Workers default to OpenCode's free model (no key).
# Note: free-tier providers may log prompts; use your own model for private work.
WORKER_IMAGE=
WORKER_MODEL=opencode/big-pickle
# Independent OpenAI-compatible endpoint. Use its exact model ID, including any organization prefix.
WORKER_BASE_URL=
# Endpoint key, or the selected hosted provider's key. Never returned to browsers.
WORKER_API_KEY=
# For LAN endpoints, explicitly allow the model server IP/CIDR in SANDBOX_ALLOW_LAN above.
# Main/worker defaults and profile endpoints/keys can also be changed in the UI after deployment.
# Saved UI defaults persist across restarts and override these defaults until reset in the UI.
# 1 = wait for you to approve Hermes' plan before workers start
JOB_PLAN_APPROVAL=1
# 1 = workers may run any shell command (0 blocks git push, sudo, curl|sh, ...)
JOB_AUTO_APPROVE=0
MAX_PARALLEL_JOBS=2
MAX_WORKERS_PER_JOB=3
MAX_WORKERS_TOTAL=4
WORKER_CPU=1
WORKER_MEMORY_MB=1536
JOB_TIMEOUT_MINUTES=30
# Tighter loop: after each wave, Hermes reviews results and may append a new wave (0 = off)
JOB_TIGHTER_LOOP=0
JOB_MAX_WAVES=3

# --- Optional ---------------------------------------------------------------
# Version checks shown in the UI (0 = off)
UPDATE_CHECK=1
OPENWEBUI_URL=
