{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$WORKBENCH_PORT} {
	encode zstd gzip

	# route keeps these in written order: client allowlist, then basic auth, then the app.
	route {
		import /etc/caddy/allow.caddy
		import /etc/caddy/auth.caddy

		handle /api/* {
			reverse_proxy {$WORKBENCH_API_UPSTREAM} {
				flush_interval -1
			}
		}

		# Hermes gateway via the companion API, which adds the gateway key server-side.
		handle_path /hermes-gw/* {
			rewrite * /api/proxy/hermes{path}
			reverse_proxy {$WORKBENCH_API_UPSTREAM} {
				flush_interval -1
			}
		}

		# Raw OpenAI-compatible model endpoint (LLM_BASE_URL).
		handle_path /llm/* {
			rewrite * {$LLM_PATH_PREFIX}{path}
			reverse_proxy {$LLM_UPSTREAM} {
				header_up Host {upstream_hostport}
				header_up -Origin
				header_up -Authorization
				import /etc/caddy/llm-auth.caddy
				flush_interval -1
			}
		}

		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}
